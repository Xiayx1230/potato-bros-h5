      "effects[].max": "加成后上限（可选，如格挡值）",
      "effects[].alsoHeal": "改 maxHp 时是否同步回复等量生命",
      "effects[].addMaxHpPercent": "按最大生命百分比回复当前生命（如 0.35）",
      "unique": "是否本局只可选一次（技能强化建议 true）",
      "skillEnhance": "引用 skill_enhances 表的 id；参数在 skill_enhances.json 配置",
      "uid": "数字ID（唯一，供前置/冲突引用）",
      "requireUid": "前置：需已选中该 uid（可逗号多个）；技能变体需先习得对应基础技能",
      "conflictUids": "互斥对方 uid（逗号分隔）；选中后双方都不再出现",
      "requireUids": "多前置时用数组；与 requireUid 二选一即可",
      "unlockSkill": "习得基础技能：填 skills.json 的 id；选中后加入技能栏",
      "rarityFrames": "稀有度→框色与权重：frame=gold/red，weightMul=抽取权重倍率"
