      "rare": "旧字段：true 等同 rarity=1；新表请用 rarity",
      "effects": "效果列表",
      "effects[].stat": "属性名：atk/def/maxHp/hp/atkSpeed/moveSpeed/skillMul/excellent/lucky/ty2/ty3/ty4/physDmg/pveDmg/dmgRate/hitRate/dodgeRate/blockRate/blockValue/pickupRange 等",
